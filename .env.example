# Copy to .env and fill in. Never commit .env.

# Model provider. Any OpenAI-compatible endpoint works.
# TensorMux (used during the hackathon):
MODEL_BASE_URL=https://api.tensormux.com/v1
MODEL_API_KEY=your-key-here
MODEL_ID=gemma-4-31b

# OpenRouter alternative:
# MODEL_BASE_URL=https://openrouter.ai/api/v1

# The AP team's account on the VendorLink supplier portal (world/portal.py).
# These are the demo world's own credentials, not a secret — the engine reads them from
# here so that nothing but env ever holds a password.
PORTAL_USER=ap-bot@kestrelmfg.com
PORTAL_PASS=tieout-demo

# Where the world's SQLite lives. Default: ~/.tieout/world.db
# TIEOUT_HOME=
# TIEOUT_WORLD_DB=

# Pin the world's month (YYYY-MM). Unset = the current month. The tests pin it.
# TIEOUT_SEED_MONTH=
