# Copy to .env and fill in. Never commit .env.

# Model provider. Any OpenAI-compatible endpoint works.
# TensorMux (the hackathon's inference partner, used during the build):
MODEL_BASE_URL=https://api.tensormux.com/v1
MODEL_API_KEY=your-key-here
MODEL_ID=glm-4-7-flash
# glm-4-7-flash is a REASONING model: it fills a separate `reasoning` field and leaves
# `content` empty until it has finished thinking. Give it room. Never call it with less
# than 600 — engine/model.py enforces that floor and doubles the budget on a retry.
MODEL_MAX_TOKENS=800

# OpenRouter alternative (swap all three lines above):
# MODEL_BASE_URL=https://openrouter.ai/api/v1

# The AP team's account on the VendorLink supplier portal (world/portal.py).
# These are the demo world's own credentials, not a secret — the engine reads them from
# here so that nothing but env ever holds a password.
PORTAL_USER=ap-bot@kestrelmfg.com
PORTAL_PASS=tieout-demo

# Browser visibility for the portal source. 0 = a real window you can film, 1 = hidden.
# The tests always run hidden.
HEADLESS=1

# Where the world's SQLite and Tieout's own memory live. Default: ~/.tieout/
# TIEOUT_HOME=
# TIEOUT_WORLD_DB=
# TIEOUT_ENGINE_DB=

# Where the engine looks for the world. Defaults match `tieout world`.
# TIEOUT_ERP_URL=http://127.0.0.1:8701
# TIEOUT_PORTAL_URL=http://127.0.0.1:8702
# TIEOUT_INBOX_URL=http://127.0.0.1:8703

# Pin the world's month (YYYY-MM). Unset = the current month. The tests pin it.
# TIEOUT_SEED_MONTH=
